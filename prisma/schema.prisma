// How Prisma generates the TypeScript database client
generator client {
  provider = "prisma-client-js"
}

// What kind of database we're using
datasource db {
  provider = "postgresql"
}

// What data we want to store
model Job { 
  id          String   @id @default(uuid())
  jobId       BigInt   @unique
  clientWallet String
  workerWallet String?
  amount      BigInt
  tokenAddress String
  status      JobStatus @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}